# Пример мода: коридор 1 труднее, граната сильнее.
# Собрать: python3 tools/mod.py <rom.nes> mods/example.tglmod build/example.tglpatch
# Положить .tglpatch в папку mods рядом с проектом Godot — он применит его при запуске.

# первая волна коридора 1 (сценарий $9D5A, банк 4): первый генератор выпускает тип 66 → тип 95
волна 4 $9D5A 1 95

# враги типа 28 (самые частые) — здоровье 1 → 4
здоровье 28 4

# граната 1-го уровня: урон 16 → 40
урон_оружия 5 1 40
