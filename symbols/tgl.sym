# Карта имён The Guardian Legend (USA, SHA-1 D00D73C7764A4C3513892B97AFB939F30E522245).
#
# Строки:
#   ram  <адрес> <байт> <имя> <статус> <описание>
#   arr  <адрес> <ячеек> <имя> <статус> <описание>       — массив по ячейкам объектов
#   code <банк> <адрес> <имя> <статус> <описание>         — процедура (банк 7 = $C000-$FFFF)
#   spot <банк> <адрес> <имя> <статус> <описание>         — место внутри процедуры
# Статус: проверено — подтверждено автоматически (tools/ramcheck.py) или кодом игры;
#         гипотеза — похоже, но не доказано.
# Имена попадают в сгенерированный перевод (комментарии и имена функций).

# ---- игрок и панель (проверено по панели: tools/ramcheck.py)
ram  $0047 1 life_max        проверено   максимум жизни
ram  $0048 1 life_target     проверено   жизнь, к которой идёт счётчик (лечение/урон)
ram  $0049 1 life            проверено   текущая жизнь (на панели: полоска и число = life/8)
ram  $004A 1 attack          гипотеза    сила атаки (ROM Detectives)
ram  $004B 1 shield          гипотеза    щит (ROM Detectives)
ram  $004C 2 chips           проверено   чипы, 16 бит (младший, старший)
ram  $004E 2 chips_max       гипотеза    предел чипов, 16 бит (ROM Detectives)
ram  $003E 1 shot_count      проверено   число SHOT на панели
ram  $0050 1 area            проверено   номер зоны (AREA на панели)
ram  $0052 1 map_x           проверено   X в лабиринте (X на панели)
ram  $0053 1 map_y           проверено   Y в лабиринте (Y на панели)
ram  $0170 7 score_digits    проверено   очки по цифре на байт, старшая первая (панель догоняет)
ram  $04AC 4 item_flags      гипотеза    флаги предметов (ROM Detectives)
ram  $04B0 1 map_key_flags   гипотеза    флаги карты и ключей (ROM Detectives)

# ---- система
ram  $0004 1 cur_bank        проверено   текущий банк $8000-$BFFF (переключатель $D705 ведёт его)
ram  $002A 1 rng             проверено   генератор случайных чисел (подмешивает указатель стека в NMI)
ram  $002B 1 frame_flag      проверено   флаг «кадр прошёл»: ставит NMI, ждёт wait_frame
ram  $00F7 1 pad             проверено   кнопки: A B Select Start Up Down Left Right = биты 7..0
ram  $00F8 1 pad_prev        гипотеза    кнопки (второй байт; стрельба проверяет pad|pad_prev)
ram  $0084 1 spr_y           проверено   временные для вывода спрайта: Y
ram  $0085 1 spr_x           проверено   … X
ram  $0086 1 spr_attr        проверено   … атрибуты
ram  $0087 1 spr_tile        проверено   … номер тайла
ram  $0200 256 oam_buf       проверено   копия спрайтов, NMI отправляет её в видеочип ($4014 = 2)

# ---- таблица объектов: 24 ячейки, каждое свойство — свой массив; ячейка 0 — игрок
arr  $0500 24 obj_type       проверено   тип объекта (0 = свободно; бит 7 — объект уже заведён, $CFA0)
arr  $0518 24 obj_y          проверено   Y на экране (код вывода спрайтов берёт отсюда)
arr  $0530 24 obj_x          проверено   X на экране
arr  $0578 24 obj_param_a    гипотеза    параметр из таблицы типа $D02C (часто убывает по 1 — таймер?)
arr  $0590 24 obj_hp         проверено   здоровье: столкновение ($D31C) вычитает obj_damage другого, 0 = гибель
arr  $05A8 24 obj_damage     проверено   урон, который объект наносит при столкновении ($D31C)
arr  $05C0 24 obj_vy_frac    проверено   скорость по Y, дробная часть (движение $CC88)
arr  $05D8 24 obj_vy         проверено   скорость по Y, целая часть со знаком
arr  $05F0 24 obj_vx_frac    проверено   скорость по X, дробная часть (движение $CCEB)
arr  $0608 24 obj_vx         проверено   скорость по X, целая часть со знаком
arr  $0620 24 obj_flags      проверено   флаги типа ($D1A9); бит 4 — не исчезать за краем экрана
arr  $0740 24 obj_last_type  проверено   тип, который был в ячейке до освобождения ($CCBF)
arr  $0758 24 obj_y_frac     проверено   Y, дробная часть
arr  $0770 24 obj_x_frac     проверено   X, дробная часть
ram  $0668 1 player_dir      гипотеза    направление игрока (стрельба по нему выбирает пулю)
ram  $003C 1 subweapon       проверено   номер спецоружия (индекс в таблицах оружия; 3 волна, 5 граната, 6 огненный шар, 8 отражатель)
ram  $003D 1 subweapon_level проверено   уровень спецоружия 1..3 (таблица урона совпала с известными значениями)

# ---- процедуры
code 7 FEDE reset            проверено   сброс: проверка банков, инициализация
code 7 FF7A main_loop        проверено   главный цикл: кадр, логика в банках 6 и 3
code 7 FF8B wait_frames      проверено   ждать Y кадров (вызывает wait_frame и обработку)
code 7 DA9A wait_frame       проверено   ждать NMI ($2B), заодно подстройка DMC для разделения экрана
code 7 DC75 nmi_handler      проверено   NMI: спрайты, видеопамять, звук, ввод
code 7 DCF3 irq_handler      проверено   IRQ от DMC: разделение экрана под панель (опрос спрайта 0)
code 7 C006 far_call         проверено   дальний вызов: JSR far / .byte банк, адрес-1
code 7 D76F far_call_body    проверено   тело дальнего вызова
code 7 D705 bank_restore     проверено   включить банк из cur_bank
code 7 D6AE jump_table       проверено   переход по встроенной таблице после JSR (индекс в A)
# места внутри процедур (не входы) — из кодов Game Genie, пока не проверены
spot 7 E325 damage_player    гипотеза    урон игроку («бесконечная энергия»)
spot 7 EB48 new_game_area    гипотеза    стартовая зона новой игры
spot 7 E998 spawn_enemies    гипотеза    появление врагов («нет врагов»)
spot 6 8AED player_fire      проверено   выстрел по кнопке A: пуля берёт X/Y игрока (ячейка 0)
code 7 CC88 obj_move_y       проверено   движение по Y: позиция += скорость; ушёл за экран — освободить
code 7 CCEB obj_move_x       проверено   движение по X
spot 7 CCBF obj_free         проверено   освобождение ячейки объекта
spot 7 CFA0 obj_init_from_type проверено заводит объект по таблицам типа: $D02C, $D0AB (здоровье), $D12A (урон), $D1A9 (флаги)
spot 7 D31C obj_collide_damage проверено столкновение: здоровье -= урон другого объекта

# ---- данные в ROM (банк 7): по 128 байт, индекс — номер типа (obj_type & $7F)
data 7 D02C type_param_a     гипотеза    → obj_param_a
data 7 D0AB type_hp          проверено   → obj_hp (здоровье; врагов коридоров заводит банк 6 своими таблицами)
data 7 D12A type_damage      проверено   → obj_damage
data 7 D1A9 type_flags       проверено   → obj_flags

# ---- оружие игрока (банк 6), индекс = 11*subweapon_level + subweapon, уровень 1..3
spot 6 86A3 weapon_shot_init проверено   выстрел спецоружием: урон, здоровье снаряда и др. из таблиц ниже
data 6 86F5 weapon_damage    проверено   урон снаряда → obj_damage (0 = урон основной пушки); совпадает: волна 1/2/6, граната 16/32/48, шар 16/24/32, отражатель 4/7/10
data 6 8716 weapon_shot_hp   гипотеза    → $7B8 и obj_hp снаряда (0 → 255, сколько ударов выдержит)
data 6 8737 weapon_param_b   гипотеза    → $698
data 6 8758 weapon_param_c   гипотеза    → obj_param_a

# ---- враги, которых заводит не $CFA0 (по записи: tools/xtest statwatch)
data 6 9AF3 enemy14_15_hp    проверено   здоровье типов 14/15, 6 вариантов (код $9A9C/$9B94)
data 6 A20F enemy39_hp       проверено   здоровье типа 39 (код $A101)
data 6 A501 enemy88_hp       проверено   здоровье типа 88 (код $A460)

# ---- волны врагов (интерпретатор сценариев; формат — tools/waves.py, проверено по записи 470/470)
code 7 F78F wave_script_step проверено   шаг сценария волн: пауза, переход, конец, враг, генератор
spot 7 E733 corridor_set_waves проверено поток данных коридора ($BC) задаёт сценарий: $66/$67, банк 4
spot 5 A480 room_set_waves   проверено   комната лабиринта: сценарий из таблицы $A4C5 по $57, банк 5
spot 7 FA4B obj_spawn_child  проверено   создать объект типа A в ячейке Y у объекта X (выстрелы врагов); вызов через $C105
ram  $0066 2 wave_ptr        проверено   указатель сценария волн
ram  $0068 1 wave_delay      проверено   пауза до следующей записи сценария (тики)
ram  $0069 1 wave_tick       проверено   делитель тика паузы
ram  $007F 1 wave_bank       проверено   банк сценария волн (4 — коридоры, 5 — лабиринт)
ram  $0033 1 fire_timer      проверено   задержка до следующего выстрела основной пушки ($8E0F, банк 3)
ram  $0039 1 fire_rate       проверено   скорострельность: значение для fire_timer
ram  $003B 1 max_shots       проверено   сколько пуль основной пушки одновременно (ячейки 1..max_shots)
data 5 A4C5 room_wave_table  проверено   указатели сценариев волн комнат лабиринта (по $57)
